{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knockoutnotes",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knockoutnotes-db",
      "database_id": "c6ca400d-3cd7-4522-9006-7da7161ae301"
    }
  ],
  // R2 bucket for the admin File Manager (worker/files.js). Create the bucket once with:
  //   wrangler r2 bucket create knockoutnotes-media
  // Until that bucket exists, uploads degrade gracefully to metadata-only records
  // (see files.js isR2Configured()) rather than failing.
  "r2_buckets": [
    {
      "binding": "R2_STORAGE",
      "bucket_name": "knockoutnotes-media"
    }
  ],
  "vars": {
    "SITE_URL": "https://knockoutnotes.knockoutnotes-anaesthesia.workers.dev",
    "ADMIN_USERNAME": "admin.knockoutnotes",
    "ADMIN_NOTIFICATION_EMAIL": "knockoutnotes.anaesthesia@gmail.com",
    // TEMPORARY MAILERSEND SANDBOX TEST SENDER ONLY:
    // Uses the MailerSend verified test domain test-86org8e1w31gew13.mlsender.net.
    // Replace with verified custom domain sender (e.g. notifications@knockoutnotes.com) once domain DNS is configured in MailerSend.
    "FROM_EMAIL": "KnockoutNotes <notifications@test-86org8e1w31gew13.mlsender.net>",
    "SUPPORT_URL": "https://bondin.io/@knockoutnotes/support"
  }
}

