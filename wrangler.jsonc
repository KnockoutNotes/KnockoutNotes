{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knockoutnotes",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knockoutnotes-db",
      "database_id": "c6ca400d-3cd7-4522-9006-7da7161ae301"
    }
  ],
  "vars": {
    "SITE_URL": "https://knockoutnotes.knockoutnotes-anaesthesia.workers.dev",
    "ADMIN_USERNAME": "admin.knockoutnotes",
    "ADMIN_NOTIFICATION_EMAIL": "knockoutnotes.anaesthesia@gmail.com",
    // TEMPORARY FOR TESTING ONLY: Replace with verified domain sender (e.g. notifications@knockoutnotes.com) in production once domain DNS is configured in Resend.
    "FROM_EMAIL": "KnockoutNotes <onboarding@resend.dev>"
  }
}

