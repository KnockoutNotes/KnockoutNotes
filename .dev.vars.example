# Cloudflare Worker Environment Variables Example
# Duplicate this file as .dev.vars for local testing with `wrangler dev`
# For production deployment, set secrets using: wrangler secret put <KEY>

# Resend API Key for outgoing emails
RESEND_API_KEY="re_your_api_key_here"

# Sender address configured & verified in your Resend domain settings
# (During initial testing before domain verification, you can use: "KnockoutNotes <onboarding@resend.dev>")
FROM_EMAIL="KnockoutNotes <notifications@knockoutnotes.com>"

# Admin portal login username
ADMIN_USERNAME="admin.knockoutnotes"

# PBKDF2-HMAC-SHA256 password hash for admin (generated with scripts/generate_password_hash.py)
ADMIN_PASSWORD_HASH="pbkdf2:100000:your_generated_salt_hex:your_generated_hash_hex"

# Email to receive automated alerts on new subscriptions/unsubscribes
ADMIN_NOTIFICATION_EMAIL="admin@knockoutnotes.com"

# Public canonical URL of the site
SITE_URL="https://knockoutnotes.knockoutnotes-anaesthesia.workers.dev"
